    "globals": "^17.14.0",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.5"
